# URL base de tu Backend. 
# IMPORTANTE: No uses 'localhost', usa la IP de tu computadora en la red Wi-Fi , http://localhost:8081/api/v1, http://localhost:4200/api/v1, http://172.25.5.11/api/v1, http://localhost/api/v1, https://serviciosfundea.org/api/v1

EXPO_PUBLIC_API_URL=http://172.25.5.11:5030/api/v1
# Banderas de entorno
EXPO_PUBLIC_ENV=development

EXPO_PUBLIC_API_CATALOGOS_URL=https://dev-api-onesite-dtd.fundea.org.gt:8086/api/onesiteex

# Servicio de carga de la agenda de clientes asignados (RF-CE-07, Sprint 14).
# A DIFERENCIA de las demas variables, aqui va el ENDPOINT COMPLETO y no una URL
# base: el servicio no comparte prefijo con ningun otro y se consume con GET, sin
# concatenarle ninguna ruta. Si falta el protocolo se antepone http:// solo (el
# servicio vive en una IP de LAN sin TLS); sin esa correccion axios la tomaria por
# ruta relativa y la peticion ni siquiera saldria del telefono, con un ERR_NETWORK
# identico al de estar fuera de cobertura.
# Si se deja sin definir, la carga de cartera degrada con un aviso explicito y el
# resto de la app sigue funcionando: NUNCA se cae a un host por defecto.
EXPO_PUBLIC_CARGA_AGENDA_CLIENTES=http://172.25.5.11:3000/api/onesiteex/precarga

# Token de ese servicio. Viaja en la cabecera 'apikey' (en minusculas y sin
# guiones: es el nombre que valida el servidor, que responde 401 API_KEY_NO_ENVIADA
# si falta). No puede ir en Authorization, que el interceptor ya usa para el JWT.
# ATENCION: toda variable EXPO_PUBLIC_* se compila dentro del bundle y se puede
# extraer de un APK distribuido. Tratese como publico: minimo privilegio y solo
# lectura de la cartera. Aqui va SIEMPRE un marcador, nunca el valor real.
EXPO_PUBLIC_TOKEN_CARGA_AGENDA_CLIENTES=coloque-aqui-el-token
