# Forzar a NPM a ignorar conflictos de peer dependencies (necesario para WatermelonDB + React 19)
legacy-peer-deps=true

# Cuarentena de paquetes recién publicados: no se resuelve ninguna versión con menos
# de 7 DÍAS publicada. La mayoría de compromisos de cadena de suministro en npm se
# detectan y se retiran en cuestión de horas, así que esta ventana los deja pasar de
# largo sin frenar el trabajo diario.
min-release-age=7
