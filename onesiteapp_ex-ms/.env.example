# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Base de Datos (SQL Server local)
#DB_HOST=localhost
#DB_PORT=5000
#DB_USERNAME=sa
#DB_PASSWORD=OneSitePass@2026
#DB_NAME=onesiteapp_ex

# Base de Datos (SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=transformacionD
DB_PASSWORD=Funde@DTD1007
DB_NAME=OneSiteEx

# Seguridad JWT (Sprint 2)
JWT_SECRET=TuClaveSecretaUltraSeguraParaElFirmaDeTokens2026
JWT_ACCESS_EXPIRATION=20m
JWT_REFRESH_EXPIRATION=15d

# Zona horaria de la operación (IANA). Se usa para convertir las fechas que envía el
# dispositivo (ISO-8601 en UTC) antes de insertarlas en columnas DATETIME, que no
# guardan zona. DEBE declararse aquí y no heredarse del sistema: en un servidor con
# TZ=UTC la conversión no se aplicaba y las capturas quedaban 6 h adelantadas, con la
# fecha correcta y solo la hora desplazada.
APP_ZONA_HORARIA=America/Guatemala

# Catálogos servidos por API externa (Sprint 9 - OrigenDatosTipo = 'API')
# El token vive SOLO aquí, en el backend: nunca debe copiarse al .env de la
# app movil (las variables EXPO_PUBLIC_* quedan embebidas y extraibles del APK).
# ADVERTENCIA: usa un valor real solo en tu .env local (gitignored). Este
# archivo es de ejemplo y SÍ se versiona en git — nunca commitear el token real aquí.
API_CATALOGOS_EXT_URL=http://172.25.5.11:3300
API_CATALOGOS_EXT_TOKEN=5e1acbd9f03b47e8c9d2a14f7b8ce61a2f7d9bc134e0a7c5f4e19a83c7b0d2f6
#API_CATALOGOS_EXT_TOKEN=<reemplazar-con-el-token-real-solo-en-.env-local>

# Header y prefijo de autenticación configurables mientras se confirma el
# esquema real de la API externa (ej. Authorization: Bearer <token>).
API_CATALOGOS_EXT_AUTH_HEADER=Authorization
API_CATALOGOS_EXT_AUTH_PREFIJO=Bearer

# --- URLs por catálogo: API_CATALOGOS_EXT_<CLAVE>_URL ---
# La CLAVE es OrigenDatosCmd normalizado (sin acentos, MAYÚSCULAS, singular o
# plural — ver domain/catalogos-externos.claves.ts). OrigenDatosCmd YA NO es
# una URL completa: es esta clave corta. Guatemala (valorCore=320) va quemada
# aquí porque otros países no tienen departamentos.
API_CATALOGOS_EXT_DEPARTAMENTOS_URL=http://172.25.5.11:3300/api/catalogos?valorCore=320&all=true&grupo=pais
# {padre} marca el catálogo como dependiente: se llama una vez por código del padre.
API_CATALOGOS_EXT_MUNICIPIOS_URL=http://172.25.5.11:3300/api/catalogos?valorCore={padre}&all=true&grupo=departamento

# --- Forma de la respuesta (cambiar de API externa = cambiar esto, sin tocar código) ---
# Ver domain/catalogos-externos.mapeo.ts. Los valores de abajo son el formato
# real confirmado de la API de catálogos de lugares.
API_CATALOGOS_EXT_RUTA_DATOS=data.catalogos
API_CATALOGOS_EXT_CLAVES_HIJOS=hijos,children
API_CATALOGOS_EXT_CAMPOS_CODIGO=valorCore,codigo,id,value,clave,codigoOpcion
API_CATALOGOS_EXT_CAMPOS_ETIQUETA=nombre,descripcion,valor,label,text,nombreCorto
API_CATALOGOS_EXT_CAMPO_ACTIVO=activo
API_CATALOGOS_EXT_CAMPO_ORDEN=orden
API_CATALOGOS_EXT_ORDENAR_ALFABETICO=true

# --- Robustez de las llamadas a la API externa ---
API_CATALOGOS_EXT_TIMEOUT_MS=8000
API_CATALOGOS_EXT_REINTENTOS=1
API_CATALOGOS_EXT_CONCURRENCIA=4
# Vuelca hasta 500 caracteres de cada respuesta cruda al log (Logger.debug).
# Dejar en false salvo mientras se diagnostica el formato de una API nueva.
API_CATALOGOS_EXT_DIAGNOSTICO=false
# =============================================================================
# Multimedia (Sprint 10)
# =============================================================================

# OBLIGATORIA y sin valor por defecto: si falta, el backend NO ARRANCA, a proposito.
# Un respaldo silencioso (escribir en ./uploads, por ejemplo) haria que todo
# "funcionara" mientras las fotos se acumulan en un directorio que el siguiente
# despliegue borra. Debe ser una ruta ABSOLUTA: una relativa se resuelve contra el
# cwd del proceso, que bajo pm2 no es la raiz del proyecto.
#
# Debe quedar FUERA del arbol servido por el servidor web: los archivos solo se
# entregan por GET /api/v1/multimedia/:id, que exige token.
MULTIMEDIA_RUTA_RAIZ=/var/datos/onesiteapp/multimedia

# Peso maximo por archivo, en KB. El interceptor corta la ingesta en este valor y
# el servicio revalida el Buffer real recibido.
MULTIMEDIA_PESO_MAXIMO_KB=5120

# --- Listas BLANCAS por tipo de medio ---
# Blancas y no negras a proposito: una lista negra siempre va por detras del
# atacante. Hay ademas una lista de extensiones prohibidas en el codigo (svg, html,
# js, exe...) que se aplica AUNQUE alguien las agregue aqui por error: un SVG
# ejecuta JavaScript al abrirse en el navegador del BackOffice.
MULTIMEDIA_EXTENSIONES_FOTO=jpg,jpeg,png,heic,heif,webp
MULTIMEDIA_EXTENSIONES_MULTIMEDIA=jpg,jpeg,png,heic,heif,webp,mp4,mov,3gp
MULTIMEDIA_EXTENSIONES_DOCUMENTO=pdf,doc,docx,xls,xlsx,csv,txt
MULTIMEDIA_EXTENSIONES_FIRMA=png,jpg,jpeg

# Limite del cuerpo JSON. Sin esta variable rige el default de Express: 100 kB, que
# una encuesta larga con matrices supera con facilidad. Los binarios NO viajan por
# aqui (van por multipart/form-data con su propio limite).
BODY_JSON_LIMITE=5mb
